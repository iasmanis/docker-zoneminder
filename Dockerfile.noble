# ZoneMinder calls this streaming server "RTSP2Web"; upstream publishes no binaries.
FROM golang:1.27-alpine AS rtsp2web

ARG RTSP2WEB_VERSION=v2.4.3

RUN apk add --no-cache git \
    && git clone --depth 1 --branch ${RTSP2WEB_VERSION} https://github.com/deepch/RTSPtoWeb /src
WORKDIR /src
RUN CGO_ENABLED=0 go build -o rtsp-to-web


FROM ubuntu:24.04

LABEL maintainer="Ingemars Asmanis"

ENV DEBIAN_FRONTEND=noninteractive
ENV ZM_VERSION=1.38.6
ENV PHPINI=/etc/php/8.3/apache2/php.ini

# Source for packages
# https://launchpad.net/~iconnor/+archive/ubuntu/zoneminder-1.38
RUN echo "# Update base packages" \
    && apt update \
    && apt upgrade --assume-yes \
    && echo "# Install pre-reqs" \
    && apt install --assume-yes --no-install-recommends gnupg curl software-properties-common file \
    && echo "# Configure Zoneminder PPA" \
    && add-apt-repository -y ppa:iconnor/zoneminder-1.38 \
    && apt update \
    && echo "# Install zoneminder" \
    && apt install --assume-yes zoneminder \
    && a2enconf zoneminder \
    && a2enmod rewrite cgi http2 \
    && echo "Protocols h2 h2c http/1.1" > /etc/apache2/conf-available/http2.conf \
    && a2enconf http2 \
    && sed -i -e "s/error_reporting =.*/error_reporting = E_ALL \& ~E_NOTICE \& ~E_STRICT \& ~E_DEPRECATED/g" $PHPINI \
    && rm -r /var/lib/apt/lists/*

# Install the RTSP2Web streaming server
COPY --from=rtsp2web /src/rtsp-to-web /opt/rtsp2web/rtsp-to-web
COPY --from=rtsp2web /src/web /opt/rtsp2web/web
COPY utils/rtsp2web.json /usr/local/share/rtsp2web/config.json

HEALTHCHECK --interval=15s --timeout=10s --retries=3 \
    CMD ["curl", "--fail", "http://localhost/zm/api/host/getVersion.json"] || exit 1


# Setup Volumes
VOLUME /var/cache/zoneminder/events /var/cache/zoneminder/images /var/lib/mysql /var/log/zm /var/lib/rtsp2web

# Expose http and RTSP2Web ports
EXPOSE 80 8083

# Configure entrypoint
COPY utils/entrypoint.sh /usr/local/bin/
RUN chmod 755 /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
